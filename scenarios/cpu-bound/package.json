{
  "name": "scenario-cpu-bound",
  "private": true,
  "type": "module",
  "description": "Scenario: a 5 s CPU calculation in an async handler blocks every other request; block vs setImmediate chunking vs worker pool vs job queue",
  "engines": { "node": ">=24" },
  "scripts": {
    "valkey:up": "docker run -d --name scen-cpu-valkey -p 127.0.0.1:6391:6379 valkey/valkey:9.1.3-alpine",
    "valkey:down": "docker rm -fv scen-cpu-valkey",
    "bench": "node bench.mjs",
    "transfer": "node transfer.mjs",
    "async": "node async-is-not-a-thread.mjs"
  },
  "dependencies": {
    "autocannon": "8.0.0",
    "bullmq": "6.5.2",
    "ioredis": "6.0.0",
    "piscina": "5.3.2"
  },
  "overrides": {
    "hyperid": "4.0.0"
  }
}
