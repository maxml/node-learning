{
  "name": "scenario-error-handling",
  "private": true,
  "type": "module",
  "description": "NestJS: HttpException in services vs. domain errors mapped at the edges (HTTP filter + worker adapter)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:up": "docker run -d --rm --name scen-errors-pg -e POSTGRES_PASSWORD=pg -e POSTGRES_DB=errs -p 55436:5432 postgres:18",
    "db:down": "docker rm -f scen-errors-pg",
    "test": "npm run build && node --test --test-concurrency=1 --test-reporter=spec \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
