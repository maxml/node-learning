{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "target": "es2023",
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "lib": ["dom", "esnext"],
    "types": ["node"],
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
  "include": ["src/**/*"]
}
